# ── Movimiento 3: páginas migradas de WordPress al sitio nuevo ───────────────
#
# LA MAYORÍA DE MIGRACIONES NO NECESITAN NADA AQUÍ.
#
# Apache sirve los directorios reales antes de llegar al catch-all de WordPress.
# En cuanto el sitio nuevo genere /golden-visa/index.html, esa URL la sirve el
# sitio nuevo automáticamente y WordPress deja de verla. Sin reglas, sin reinicio
# y sin ventana: basta con crear la ruta en Next y publicar. Para revertir, se
# quita la ruta y WordPress vuelve a atenderla.
#
# ESTE ARCHIVO ES SÓLO PARA CUANDO LA URL CAMBIA.
#
# Cuatro páginas viven a cuatro niveles de profundidad, por ejemplo
#   /pro-corp-sas/soluciones-legales-y-comunitarias/nacionalidad-europea-por-ley-sefardi/portugal/
# Si al migrarlas se acorta la URL, la antigua debe seguir respondiendo con un
# 301 hacia la nueva: está indexada y enlazada desde fuera. Ese redirect va aquí.
#
# Formato (mismo estilo que los redirects del blog, mod_rewrite para que se
# apliquen antes que el catch-all de WordPress):
#
#   RewriteRule ^ruta/vieja/completa/?$ /ruta-nueva/ [R=301,L]
#
# Ejemplo, cuando se migre la landing de Portugal:
#
#   RewriteRule ^pro-corp-sas/soluciones-legales-y-comunitarias/nacionalidad-europea-por-ley-sefardi/portugal/?$ /portugal-sefardi/ [R=301,L]
#
# Tras editar este archivo:
#   ./scripts/gen-htaccess.sh > deploy/htaccess-produccion
#   y desplegarlo (ver README).

<IfModule mod_rewrite.c>
RewriteEngine On

# ── Slugs coherentes con el menú (2026-10-19) ──
# Cada página del menú vive en el slug de su nombre. Las URLs anteriores
# responden con 301 a la nueva (están indexadas y enlazadas desde fuera).
#   Proyectos                     /sectors/            → /projects/
#   Crecimiento Sostenible - BPA  /studio/             → /sustainable-growth/
#   Soluciones Legales            /projects/  (ahora es Proyectos; la página
#                                  legal vive en /legal-solutions/ — la URL
#                                  vieja no puede redirigir porque se reutiliza)
#   Fichas de servicio            /projects/<servicio>/ → /solutions/<servicio>/
#   Blog                          /journal/…           → /blog/…
# /journal/media/ NO se redirige: son las imágenes de los artículos antiguos
# (public/journal/media) y siguen ahí.

RewriteRule ^sectors/?$ /projects/ [R=301,L]
RewriteRule ^studio/?$ /sustainable-growth/ [R=301,L]
RewriteRule ^projects/(legal-solutions|sustainable-growth|ip2-engineering|exchange-platform|business-process-automation)/?$ /solutions/$1/ [R=301,L]
RewriteRule ^journal/?$ /blog/ [R=301,L]
RewriteCond %{REQUEST_URI} !^/journal/media/
RewriteRule ^journal/(.+?)/?$ /blog/$1/ [R=301,L]

</IfModule>

# ── Artículos del blog ──────────────────────────────────────────────────
#
# El Journal entero se sirve en vivo desde Supabase — no existe ningún
# directorio prebuilt bajo /blog/ para ningún artículo (la exportación ya
# no genera páginas individuales). Sin esta regla esas URLs llegan al
# catch-all de WordPress del final y mueren en su 404 — el artículo aparece en
# el listado y no se puede abrir.
#
# El rewrite es interno (el navegador sigue viendo /blog/<id>/) y sólo
# actúa cuando no hay archivo ni directorio real. La página de destino busca
# el artículo por su id (wp_id) directamente en Supabase — el id, no el
# slug, para que la URL no se rompa si editan el título del post.
#
# Va ANTES del bloque de WordPress: el orden es lo que la hace ganar.
# Réplica de la misma regla en public/.htaccess (beta).
# Ver docs/decisions/0004-journal-live-fetch.md.

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/[^/]+/?$ /blog/live-fallback/index.html [L]

</IfModule>

