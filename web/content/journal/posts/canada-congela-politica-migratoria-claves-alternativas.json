type\": \"Organization\", \"name\": \"Pro Corp\" },\n        \"image\": \"https://tudominio.com/assets/canada-migration.jpg\"\n      }\n    </script>\n\n\n\n    <!-- Tabla de contenidos -->\n    <nav class=\"toc\">\n      <h2>Contenido</h2>\n      <ul>\n        <li><a href=\"#giro\">Un giro en la política migratoria canadiense</a></li>\n        <li><a href=\"#destino\">Canadá, destino de referencia en transformación</a></li>\n        <li><a href=\"#reduccion\">Reducción de permisos y mayor control</a></li>\n        <li><a href=\"#alternativas\">Mirar a otros destinos: la oportunidad de Europa</a></li>\n        <li><a href=\"#procorp\">En Pro Corp, soluciones legales para abrir nuevas puertas</a></li>\n      </ul>\n    </nav>\n\n    <article>\n      <h1>Canadá congela su política migratoria: Claves y alternativas</h1>\n\n      <section id=\"giro\">\n        <h2>Un giro en la política migratoria canadiense</h2>\n        <p>El Gobierno de Canadá ha anunciado un cambio estratégico en su política de inmigración que está generando debate a nivel internacional. A partir de este verano, el país reducirá de forma significativa la emisión de permisos de residencia temporal y endurecerá los requisitos para nuevos solicitantes. El objetivo es aliviar la presión sobre la vivienda y los servicios públicos tras varios años de cifras migratorias récord.</p>\n      </section>\n\n   \n    </article>\n\n   \n  </div>\n\n  <!-- Script para smooth scroll -->\n  <script>\n    document.querySelectorAll('.toc a').forEach(link => {\n      link.addEventListener('click', e => {\n        e.preventDefault();\n        const target = document.querySelector(link.getAttribute('href'));\n        if (target) target.scrollIntoView({ behavior: 'smooth' });\n      });\n    });\n  </script>\n\n  <!-- Estilos integrados -->\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap');\n    body { font-family: 'Montserrat', sans-serif; background: #fff; c