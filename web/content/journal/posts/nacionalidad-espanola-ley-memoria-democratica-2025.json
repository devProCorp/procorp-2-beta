: 700;\n    margin: 2rem 0 1rem;\n  }\n  h3 {\n    color: var(--secondary);\n    font-weight: 600;\n    margin: 1.5rem 0 0.75rem;\n  }\n  /* ===== CTA ===== */\n  .cta {\n    background: var(--primary);\n    color: #fff;\n    padding: 2.5rem 2rem;\n    text-align: center;\n    border-radius: 0.75rem;\n    margin: 4rem auto 3rem;\n    max-width: 720px;\n  }\n  .cta a {\n    background: #fff;\n    color: var(--primary);\n    padding: 0.9rem 1.8rem;\n    border-radius: 4px;\n    font-weight: 700;\n    text-decoration: none;\n    display: inline-block;\n    margin-top: 1rem;\n  }\n  .cta a:hover {\n    background: var(--secondary);\n    color: #fff;\n  }\n</style>\n\n<!-- ===== HERO SECTION ===== -->\n<header class=\"hero\">\n  <div class=\"hero-content\">\n    <h1>La Ley de Memoria Democrática en España: una oportunidad histórica que expira en octubre&nbsp;de&nbsp;2025</h1>\n    <p>Reconocimiento, justicia y nacionalidad española para los descendientes del exilio — ¡aprovecha antes de que el plazo cierre!</p>\n  </div>\n</header>\n\n<!-- ===== AUDIO ===== -->\n\n\n<!-- ===== TABLA DE CONTENIDOS ===== -->\n<details class=\"toc\" open>\n  <summary>Contenido</summary>\n  <a href=\"#verdad\">Un compromiso con la verdad y la justicia</a>\n  <a href=\"#nacionalidad\">La nacionalidad como reparación transgeneracional</a>\n  <a href=\"#resultados\">Resultados tangibles y cambios visibles</a>\n  <a href=\"#ventana\">Una ventana de oportunidad que se cierra</a>\n  <a href=\"#puente\">Un puente entre generaciones</a>\n  <a href=\"#asesoria\">El respaldo de una asesoría experta es clave</a>\n</details>\n\n<!-- ===== INTRODUCCIÓN ===== -->\n<section class=\"intro\">\n  <p>La Ley de Memoria Democrática, aprobada en octubre de 2022, representa uno de los avances legislativos más significativos de las últimas décadas en materia de reconocimiento, reparación y justicia para las víctimas del franquismo y sus descendientes. Esta normativa no surge de la nada, sino que amplía y perfecciona la anterior Ley de Memoria Histórica de 2007, incorporando principios de derecho internacional como verdad, justicia, reparación y garantías de no repetición, alineándose con estándares internacionales de derechos humanos.</p>\n</section>\n\n\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"ob-is-breaking-bad elementor-section elementor-top-section elementor-element elementor-element-fac6d1d elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"fac6d1d\" data-element_type=\"section\" data-settings=\"{&quot;_ob_bbad_use_it&quot;:&quot;yes&quot;,&quot;_ob_bbad_sssic_use&quot;:&quot;no&quot;,&quot;_ob_glider_is_slider&quot;:&quot;no&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-716b6e7\" data-id=\"716b6e7\" data-element_type=\"column\" data-settings=\"{&quot;_ob_bbad_is_stalker&quot;:&quot;no&quot;,&quot;_ob_teleporter_use&quot;:false,&quot;_ob_column_hoveranimator&quot;:&quot;no&quot;,&quot;_ob_column_has_pseudo&quot;:&quot;no&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-b1c563e ob-has-background-overlay elementor-widget elementor-widget-video\" data-id=\"b1c563e\" data-element_type=\"widget\" data-settings=\"{&quot;video_type&quot;:&quot;hosted&quot;,&quot;controls&quot;:&quot;yes&quot;,&quot;_ob_perspektive_use&quot;:&quot;no&quot;,&quot;_ob_poopart_use&quot;:&quot;yes&quot;,&quot;_ob_shadough_use&quot;:&quot;no&quot;,&quot;_ob_allow_hoveranimator&quot;:&quot;no&quot;,&quot;_ob_widget_stalker_use&quot;:&quot;no&quot;}\" data-widget_type=\"video.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"e-hosted-video elementor-wrapper elementor-open-inline\">\n